۸_تابع زیر را نوشته و آزمایش کنید این تابع در بین n عنصر اول آرایه،مقدار کمینه (مینیمم) برمیگرداند.

loat min (float a[ ], int n);

پاسخ:
#include<iostream.h>

float min(float[], int);

int main()
{
    float a[] = {11.1, 33.3, 5.5, 77.7, 22.2};
    int size = sizeof(a) / sizeof(float);

    cout << "min(a,size) = " << min(a, size) << endl;

    return 0;
}

float min(float a[], int n)
{
    float m = a[0];

    for(int i = 1; i < n; i++)
        if(a[i] < m)
            m = a[i];

    return m;
}
